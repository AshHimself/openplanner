# Vercel Postgres — copy from the Vercel dashboard after provisioning the DB
POSTGRES_URL="postgres://..."
POSTGRES_PRISMA_URL="postgres://..."
POSTGRES_URL_NON_POOLING="postgres://..."
POSTGRES_USER="..."
POSTGRES_HOST="..."
POSTGRES_PASSWORD="..."
POSTGRES_DATABASE="..."

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"

# Required for NextAuth v5 when running behind a proxy / on Vercel
AUTH_TRUST_HOST=true
